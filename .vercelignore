# Keep server/database artifacts out of the public static deploy.
# Vercel serves repo-root files statically; anything listed here is never
# uploaded, so it cannot be fetched over HTTP (e.g. /migrate.sql).

# SQL schema, migrations and seeds
*.sql
migrations/
seed-admin.example.sql

# Supabase project config, Edge Functions and local state (deployed separately)
supabase/

# Local tooling and docs not needed by the browser app
scripts/
SECURITY.md

# Internal engineering docs — keep in the repo but never serve publicly.
# architecture.html details the schema, RLS posture and infrastructure; it was
# reachable at /architecture.html until 29 Aug 2026.
code-review-findings.html
critical-fixes-report.html
remaining-fixes-report.html
architecture.html

# Local env / git
.env*
.git

# Vercel auto-publishes any /api folder as live serverless functions.
# The backend is Supabase Edge Functions only — keep this door shut.
api/
